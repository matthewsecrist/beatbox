{
  "name": "beatbox",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check",
    "test": "node --test \"src/**/*.test.js\" \"src/**/*.test.mjs\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node db/seed.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@lucide/svelte": "^1.48.0",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  }
}
