# Copy to .env and fill in. Only BETTER_AUTH_SECRET is required in production.

# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's public URL, used in the sign-in links that are emailed.
# Defaults to http://localhost:5173 in development.
BETTER_AUTH_URL=

# SQLite file or any libSQL URL; defaults to file:beatbox.db.
# DATABASE_URL=file:beatbox.db
# DATABASE_AUTH_TOKEN=

# Previews only (set in wrangler.jsonc): hosts sign-in links may use, e.g. *-beatbox.example.workers.dev
# BETTER_AUTH_ALLOWED_HOSTS=
